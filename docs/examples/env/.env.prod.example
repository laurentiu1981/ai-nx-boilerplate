# Production environment — template. Copy to .env on the VPS.
# Keep this MINIMAL: only required secrets plus overrides. Everything else has a
# sensible default in docker-compose-prod.yml.

# ── Required secrets ─────────────────────────────────────────────────────────
JWT_SECRET=
POSTGRES_PASSWORD=

# ── Google OAuth (enables sign-in) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Images / registry (optional overrides) ───────────────────────────────────
# One private repo shared by ALL projects; project + component encoded in the tag.
# IMAGE_REPO={{docker_repository}}
# Pin exact versions for rollback (default: the floating tags):
# API_IMAGE={{docker_repository}}:{{project_name|slug}}-api-<sha>
# WEB_IMAGE={{docker_repository}}:{{project_name|slug}}-web-<sha>
# Registry cleanup auth (docker:tags:prune; falls back to docker login creds):
# DOCKERHUB_USER=
# DOCKERHUB_TOKEN=

# ── Domain (optional — compose defaults to https://{{domain}}) ───────────────
# FRONTEND_URL=https://{{domain}}
# NEXT_PUBLIC_API_URL=https://{{domain}}/api
# NEXT_PUBLIC_GRAPHQL_URL=https://{{domain}}/graphql
# GOOGLE_CALLBACK_URL=https://{{domain}}/api/auth/google/callback

# ── Ports (optional — must match the reverse proxy config) ───────────────────
# WEB_PORT={{prod_port_web}}
# API_PORT={{prod_port_api}}
