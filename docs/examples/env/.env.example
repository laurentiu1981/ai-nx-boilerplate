# Dev environment — template. Copy to .env; docker compose up -d works with zero
# edits because every value here mirrors a ${VAR:-default} in docker-compose.yml.
# {{port_band}} = the project's two-digit port-band prefix (see docs/examples/ports.md).

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB={{project_name|machine_name}}
POSTGRES_USER={{project_name|machine_name}}
POSTGRES_PASSWORD={{project_name|machine_name}}_pass
# Host-side URL (for running db tools from the host); inside compose the api
# uses postgres:5432 via the compose-provided DATABASE_URL.
DATABASE_URL=postgresql://{{project_name|machine_name}}:{{project_name|machine_name}}_pass@localhost:{{port_band}}30/{{project_name|machine_name}}

# ── JWT authentication ───────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Without these the app runs fine, but the "Continue with Google" button returns
# 503. Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client → Web application) and add the callback URL below as an
# "Authorized redirect URI". See docs/examples/auth/google-oauth.md.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:{{port_band}}20/api/auth/google/callback

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:{{port_band}}10
NEXT_PUBLIC_API_URL=http://localhost:{{port_band}}20/api
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:{{port_band}}20/graphql
NEXT_PUBLIC_APP_NAME={{project_name}}

# ── GraphQL (dev: open; prod compose defaults these to false) ────────────────
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# ── AI providers (optional) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Ports (uncomment only on collision — defaults come from the compose file) ─
# WEB_PORT={{port_band}}10
# API_PORT={{port_band}}20
# POSTGRES_PORT={{port_band}}30
# PGADMIN_PORT={{port_band}}50

# ── pgAdmin (profile: tools) ─────────────────────────────────────────────────
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=admin
